---
import type { Locale, SiteSettings } from '../lib/cms'
import { localizeHref, normalizePath, routes, type Alternates } from '../i18n/routes'
import { useTranslations } from '../i18n/ui'
import LanguageSwitcher from './LanguageSwitcher.astro'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  locale: Locale
  settings: SiteSettings
  alternates: Alternates
  /** path của trang hiện tại (để đánh dấu mục menu đang mở) */
  currentPath?: string
}

const { locale, settings, alternates, currentPath } = Astro.props
const t = useTranslations(locale)
const home = routes.home(locale)

// Menu từ CMS; CMS chưa cấu hình → menu mặc định theo ngôn ngữ.
// Link nội bộ nhập theo path vi (/blog, /gioi-thieu…) → đổi sang trang tương đương của ngôn ngữ đang xem.
const cmsNav = (settings.nav ?? []).filter((item) => item?.label && item?.href)
const nav = cmsNav.length
  ? cmsNav.map((item) => ({ label: item.label, href: localizeHref(item.href, locale) }))
  : [
      { label: t('nav.blog'), href: routes.blog(locale) },
      { label: t('nav.about'), href: routes.about(locale) },
    ]

const current = currentPath ? normalizePath(currentPath) : null
function ariaCurrent(href: string): 'page' | 'true' | undefined {
  if (!current || !href.startsWith('/')) return undefined
  const target = normalizePath(href)
  if (target === current) return 'page'
  // Đang ở trang con của mục (vd bài viết trong /blog/) → đánh dấu mục cha
  if (target !== home && current.startsWith(target)) return 'true'
  return undefined
}
---

<header class="border-b border-line">
  <div class="site-container flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4">
    <a
      href={home}
      class="rounded-sm py-1 text-lg font-bold tracking-tight text-fg transition-colors hover:text-accent"
      aria-current={current === home ? 'page' : undefined}
    >
      {settings.siteName}
    </a>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-[0.9375rem]">
      {
        nav.length > 0 && (
          <nav aria-label={t('nav.label')}>
            <ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
              {nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={ariaCurrent(item.href)}
                    class="inline-block py-1.5 text-muted transition-colors hover:text-accent aria-[current]:font-medium aria-[current]:text-fg"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <LanguageSwitcher locale={locale} alternates={alternates} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>
