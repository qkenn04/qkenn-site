---
// Thẻ bài viết trong danh sách: tiêu đề (link phủ cả thẻ), ngày, danh mục, tóm tắt, ảnh card nếu có.
import type { Locale, Post } from '../lib/cms'
import { routes } from '../i18n/routes'
import { useTranslations } from '../i18n/ui'
import CmsImage from './CmsImage.astro'
import { pickImage } from './media'
import PostMeta from './PostMeta.astro'

interface Props {
  post: Post
  locale: Locale
  headingLevel?: 2 | 3
  /** Ảnh card tải ngay + fetchpriority cao (thẻ đầu danh sách, xem PostList) */
  priority?: boolean
}

const { post, locale, headingLevel = 2, priority = false } = Astro.props
const t = useTranslations(locale)
const Heading = headingLevel === 3 ? 'h3' : 'h2'
// Bài chưa dịch: tiêu đề/tóm tắt đang là tiếng Việt
const contentLang = post.isFallback && locale !== 'vi' ? 'vi' : undefined
const hasImage = !!pickImage(post.coverImage, 'card')
---

<article
  class:list={[
    'group relative grid gap-4 py-7',
    hasImage && 'sm:grid-cols-[minmax(0,1fr)_11rem] sm:items-start sm:gap-6',
  ]}
>
  <div class="min-w-0">
    <Heading class="text-xl font-semibold leading-snug tracking-tight text-balance text-fg">
      <a
        href={routes.post(locale, post.slug)}
        lang={contentLang}
        class="transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent"
      >
        {post.title}
      </a>
    </Heading>
    <PostMeta class="mt-2" locale={locale} publishedAt={post.publishedAt} categories={post.categories} raised />
    {
      post.excerpt && (
        <p class="mt-3 line-clamp-3 leading-relaxed text-muted" lang={contentLang}>
          {post.excerpt}
        </p>
      )
    }
    {
      contentLang && (
        <p class="mt-3 text-xs font-medium uppercase tracking-wide text-muted">{t('posts.viOnly')}</p>
      )
    }
  </div>
  {
    hasImage && (
      <CmsImage
        media={post.coverImage}
        variant="card"
        priority={priority}
        sizes="(min-width: 40rem) 11rem, calc(100vw - 2.5rem)"
        class="order-first aspect-video w-full rounded-lg bg-subtle object-cover sm:order-none sm:mt-1"
      />
    )
  }
</article>
