---
// Phân trang danh sách blog: Trang trước · Trang x/y · Trang sau (ẩn khi chỉ có 1 trang)
import type { Locale } from '../lib/cms'
import { routes } from '../i18n/routes'
import { useTranslations } from '../i18n/ui'

interface Props {
  locale: Locale
  currentPage: number
  lastPage: number
}

const { locale, currentPage, lastPage } = Astro.props
const t = useTranslations(locale)
const prev = currentPage > 1 ? routes.blog(locale, currentPage - 1) : null
const next = currentPage < lastPage ? routes.blog(locale, currentPage + 1) : null
const linkClass =
  'inline-flex items-center gap-1.5 rounded-md border border-line px-3 py-2 font-medium text-fg transition-colors hover:border-accent hover:text-accent'
---

{
  lastPage > 1 && (
    <nav aria-label={t('pagination.label')} class="mt-10 grid grid-cols-3 items-center gap-3 text-sm">
      <div>
        {prev && (
          <a href={prev} rel="prev" class={linkClass}>
            <span aria-hidden="true">←</span>
            {t('pagination.prev')}
          </a>
        )}
      </div>
      <p class="text-center text-muted">
        {t('pagination.status', { current: currentPage, total: lastPage })}
      </p>
      <div class="text-right">
        {next && (
          <a href={next} rel="next" class={linkClass}>
            {t('pagination.next')}
            <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </nav>
  )
}
