---
import type { Page } from 'astro'
import { getSiteSettings, type Locale, type Post } from '../../lib/cms'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Pagination from '../Pagination.astro'
import PostList from '../PostList.astro'
import { buildBreadcrumbList } from '../../lib/structured-data'
import { routes } from '../../i18n/routes'
import { countPosts, otherLocale, useTranslations } from '../../i18n/ui'
import type { CategorySummary } from './static-paths'

interface Props {
  locale: Locale
  page: Page<Post>
  categories: CategorySummary[]
  /** số trang của danh sách ở ngôn ngữ còn lại (để nút chuyển ngôn ngữ về đúng trang) */
  otherLastPage: number
}

const { locale, page, categories, otherLastPage } = Astro.props
const t = useTranslations(locale)
const settings = await getSiteSettings(locale)

const other = otherLocale(locale)
const n = page.currentPage
const path = routes.blog(locale, n)
const hasEquivalent = n <= otherLastPage
const alternates = { [locale]: path, [other]: routes.blog(other, hasEquivalent ? n : 1) }
const title = n > 1 ? t('blog.pageTitle', { page: n }) : t('blog.title')
---

<BaseLayout
  locale={locale}
  settings={settings}
  title={title}
  description={t('blog.description', { site: settings.siteName })}
  path={path}
  alternates={alternates}
  hreflang={hasEquivalent ? alternates : { [locale]: path }}
  structuredData={({ absolute, canonicalUrl }) => [
    buildBreadcrumbList(`${canonicalUrl ?? absolute(path)}#breadcrumb`, [
      { name: t('nav.home'), url: absolute(routes.home(locale)) },
      { name: t('blog.title'), url: absolute(routes.blog(locale)) },
      ...(n > 1 ? [{ name: title, url: absolute(path) }] : []),
    ]),
  ]}
>
  <header class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('blog.title')}</h1>
    <p class="mt-3 text-muted">{t('blog.intro')}</p>
    {
      categories.length > 0 && (
        <nav aria-label={t('blog.categories')} class="mt-6">
          <ul class="flex flex-wrap gap-2">
            {categories.map((c) => (
              <li>
                <a
                  href={routes.category(locale, c.slug)}
                  class="inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1 text-sm text-fg transition-colors hover:border-accent hover:text-accent"
                >
                  {c.title}
                  <span class="text-xs text-muted" aria-hidden="true">
                    {c.count}
                  </span>
                  <span class="sr-only">({countPosts(locale, c.count)})</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </header>

  <PostList posts={page.data} locale={locale} emptyText={t('posts.empty')} headingLevel={2} priority={n === 1} />
  <Pagination locale={locale} currentPage={n} lastPage={page.lastPage} />
</BaseLayout>
