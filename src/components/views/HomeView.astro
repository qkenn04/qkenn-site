---
import { getPosts, getSiteSettings, type Locale } from '../../lib/cms'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostList from '../PostList.astro'
import { routes } from '../../i18n/routes'
import { useTranslations } from '../../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
const [settings, posts] = await Promise.all([getSiteSettings(locale), getPosts(locale)])
const latest = posts.slice(0, 5)
const tagline = settings.tagline?.trim()
const description = settings.description?.trim()
---

<BaseLayout
  locale={locale}
  settings={settings}
  description={description || tagline}
  path={routes.home(locale)}
  alternates={{ vi: routes.home('vi'), en: routes.home('en') }}
>
  <section class="mb-14" aria-labelledby="intro-title">
    <h1 id="intro-title" class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
      {settings.siteName}
    </h1>
    {tagline && <p class="mt-3 text-lg font-medium text-balance text-fg sm:text-xl">{tagline}</p>}
    <p class="mt-4 max-w-[60ch] text-base leading-relaxed text-muted sm:text-lg">
      {description || t('site.defaultDescription')}
    </p>
  </section>

  <section aria-labelledby="latest-title">
    <h2 id="latest-title" class="border-b border-line pb-3 text-lg font-semibold tracking-tight">
      {t('home.latest')}
    </h2>
    <PostList posts={latest} locale={locale} emptyText={t('posts.empty')} headingLevel={3} />
    {
      posts.length > 0 && (
        <p class="mt-6 border-t border-line pt-6">
          <a
            href={routes.blog(locale)}
            class="inline-flex items-center gap-1.5 font-medium text-accent underline-offset-4 hover:underline"
          >
            {t('home.allPosts')}
            <span aria-hidden="true">→</span>
          </a>
        </p>
      )
    }
  </section>
</BaseLayout>
