---
import '../styles/global.css'
import { getPage, locales, type Locale, type Media, type SiteSettings } from '../lib/cms'
import {
  buildGraph,
  buildPerson,
  buildWebSite,
  profileUrls,
  serializeJsonLd,
  type JsonLdNode,
} from '../lib/structured-data'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import SeoHead, { type SeoArticle } from '../components/SeoHead.astro'
import { pickOgImage } from '../components/media'
import type { Alternates } from '../i18n/routes'
import { localeMeta, useTranslations } from '../i18n/ui'

/** Thông tin view cần để dựng node JSON-LD riêng của trang (BlogPosting, BreadcrumbList…) */
export interface JsonLdContext {
  /** https://qkenn.cloud/ */
  siteUrl: string
  /** path → URL tuyệt đối */
  absolute: (path: string) => string
  /** URL canonical tuyệt đối của trang (undefined nếu trang không có canonical) */
  canonicalUrl?: string
  /** meta description đã chuẩn hoá */
  description: string
  /** Ảnh og (og → hero) tuyệt đối, hoặc null */
  imageUrl: string | null
}

interface Props {
  locale: Locale
  settings: SiteSettings
  /** Tiêu đề trang (không kèm tên site). Bỏ trống = trang chủ. */
  title?: string
  description?: string | null
  /** path của trang này; không có → không canonical (vd 404) */
  path?: string
  /** Trang tương đương ở từng ngôn ngữ — dùng cho nút chuyển ngôn ngữ */
  alternates: Alternates
  /** hreflang; mặc định = alternates (chỉ đưa vào những bản thực sự tương đương) */
  hreflang?: Alternates
  /** canonical khác path (vd bài chưa dịch → bản tiếng Việt gốc) */
  canonicalPath?: string
  image?: Media | null
  article?: SeoArticle
  noindex?: boolean
  /**
   * JSON-LD: mặc định mọi trang có WebSite + Person; hàm trả thêm node riêng của trang.
   * false → không in JSON-LD (trang 404).
   */
  structuredData?: false | ((ctx: JsonLdContext) => JsonLdNode[])
}

const {
  locale,
  settings,
  title,
  description,
  path,
  alternates,
  hreflang,
  canonicalPath,
  image,
  article,
  noindex = false,
  structuredData,
} = Astro.props

const t = useTranslations(locale)
const siteName = settings.siteName?.trim() || 'qkenn'
const tagline = settings.tagline?.trim()
// Trang chủ: luôn "qkenn – <tagline>" (không để tiêu đề trơ một chữ), CMS chưa có tagline → câu mặc định
const fullTitle = title ? `${title} | ${siteName}` : `${siteName} – ${tagline || t('site.defaultTagline')}`
const metaDescription = (
  description?.trim() ||
  settings.description?.trim() ||
  tagline ||
  t('site.defaultDescription')
).replace(/\s+/g, ' ')
const canonical = canonicalPath ?? path
// Trang canonical ở nơi khác (bản dịch dự phòng) thì không khai báo hreflang
const hreflangMap = canonical && canonical === path ? (hreflang ?? alternates) : {}
const ogImage = pickOgImage(image)

// JSON-LD: một "@graph" / trang, node tham chiếu nhau qua @id cố định (xem src/lib/structured-data.ts)
let jsonLd: string | null = null
if (structuredData !== false) {
  const siteUrl = new URL('/', Astro.site ?? Astro.url).href
  const absolute = (p: string) => new URL(p, siteUrl).href
  // Mô tả người lấy từ SEO của trang Giới thiệu (nếu CMS có); request được cache trong lần build
  const about = await getPage('about', locale)
  const identity = {
    siteUrl,
    name: siteName,
    alternateNames: [new URL(siteUrl).hostname].filter((n) => n !== siteName),
    description: settings.description,
    personDescription: about?.meta?.description,
    sameAs: profileUrls(settings.socials),
    inLanguage: locales.map((l) => localeMeta[l].htmlLang),
  }
  const extra =
    structuredData?.({
      siteUrl,
      absolute,
      canonicalUrl: canonical ? absolute(canonical) : undefined,
      description: metaDescription,
      imageUrl: ogImage?.url ?? null,
    }) ?? []
  jsonLd = serializeJsonLd(buildGraph([buildWebSite(identity), buildPerson(identity), ...extra]))
}
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Áp dụng theme trước khi vẽ trang (không nháy màu); class `.js` = có JS → hiện nút đổi theme */}
    <script is:inline>
      ;(function () {
        var root = document.documentElement
        var stored = null
        root.classList.add('js')
        try {
          stored = localStorage.getItem('theme')
        } catch (e) {}
        root.classList.toggle(
          'dark',
          stored === 'dark' || (stored !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches),
        )
      })()
    </script>
    <SeoHead
      locale={locale}
      siteName={siteName}
      title={fullTitle}
      socialTitle={title ?? siteName}
      description={metaDescription}
      canonicalPath={canonical}
      hreflang={hreflangMap}
      image={ogImage}
      article={article}
      noindex={noindex}
      rssTitle={t('rss.title', { site: siteName })}
      author={article ? siteName : undefined}
    />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-dvh flex-col bg-bg text-fg antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-bg focus:px-4 focus:py-2 focus:font-medium focus:text-fg focus:shadow-lg focus:ring-2 focus:ring-accent"
    >
      {t('a11y.skip')}
    </a>
    <Header locale={locale} settings={{ ...settings, siteName }} alternates={alternates} currentPath={path} />
    <main id="main" tabindex="-1" class="site-container flex-1 py-10 focus:outline-none sm:py-14">
      <slot />
    </main>
    <Footer locale={locale} settings={{ ...settings, siteName }} />
  </body>
</html>
